								height="64"
								loading="lazy"
								decoding="async"
								class="h-16 w-16 shrink-0 rounded-2xl object-contain"
							/>
							<div>
								<h2 class="text-base font-bold text-slate-900">
									Written by {SITE.author}
								</h2>
								<p class="mt-1 text-sm leading-relaxed text-slate-500">
									Developer of WifiHeatmap, the open-source (GPL-3.0) Android
									Wi-Fi analyser and indoor site survey app. The measurements
									behind this guide come from the same tool the app uses.
								</p>
								<a
									href={`${SITE.base}/about/`}
