								>
									More about the app
									<svg
										class="h-3.5 w-3.5"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M5 12h14m-6-7 7 7-7 7"
										/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				</article>
			</div>
		</div>

		<!-- ============ FAQ ============ -->
		<section
			class="section-y mt-10 border-t border-slate-900/8 bg-white/40"
