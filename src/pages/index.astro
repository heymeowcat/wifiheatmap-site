---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import FeatureShowcase from "../components/FeatureShowcase";
import Footer from "../components/Footer.astro";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "WifiHeatmap",
	operatingSystem: "Android 7.0 and up",
	applicationCategory: "UtilitiesApplication",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description:
		"Android Wi-Fi analyzer and indoor site survey tool. Generate real-time signal heatmaps, graph 2.4/5/6 GHz spectrums, and rate channels with 100% offline privacy.",
	author: {
		"@type": "Person",
		name: "heymeowcat",
	},
};
---

<Layout
	title="WifiHeatmap — Wi-Fi Analyzer & Indoor Survey Tool"
	structuredData={structuredData}
>
	<main class="bg-[#050814]">
		<Hero />

		<!-- Interactive Feature Suite -->
		<section id="features">
			<FeatureShowcase client:load />
		</section>

		<!-- Architectural Deep Dive / Feature Grid -->
		<section class="py-24 border-t border-slate-800/80 bg-[#070c1c] relative">
			<div class="container mx-auto px-6 max-w-7xl">
				<div class="text-center max-w-3xl mx-auto mb-16">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-semibold uppercase tracking-wider mb-4">
						<span>Engineered For Precision</span>
					</div>
					<h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
						Built for Wireless Professionals & Enthusiasts
					</h2>
					<p class="text-slate-400 text-lg leading-relaxed">
						From enterprise campus Wi-Fi site surveys to home mesh network tuning, WifiHeatmap gives you complete technical control.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					<!-- Card 1 -->
					<div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all group">
						<div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">PDR Motion Kinematics</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Walk through facilities naturally. Our Pedestrian Dead Reckoning algorithm leverages the adaptive Weinberg model to calculate individual step lengths and compass heading for automatic on-map tracking.
						</p>
					</div>

					<!-- Card 2 -->
					<div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/40 transition-all group">
						<div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Wi-Fi 6E & Wi-Fi 7 Ready</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Diagnose clean 6 GHz spectrums alongside legacy 2.4 GHz and 5 GHz. Fully detects modern 802.11ax and 802.11be channels with bandwidths spanning 20, 40, 80, 160, and 320 MHz.
						</p>
					</div>

					<!-- Card 3 -->
					<div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-amber-500/40 transition-all group">
						<div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Channel Rating Optimizer</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Eliminate channel congestion and co-channel degradation. Automated star-rating analysis reveals exactly which channels in your area suffer from overlapping interference.
						</p>
					</div>

					<!-- Card 4 -->
					<div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/40 transition-all group">
						<div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Vendor OUI Lookup</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Identify access point manufacturers instantly from MAC address Organizationally Unique Identifiers (OUI) — detect Cisco, Aruba, Ubiquiti, Apple, Netgear, and TP-Link devices.
						</p>
					</div>

					<!-- Card 5 -->
					<div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-teal-500/40 transition-all group">
						<div class="w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Signal Stability Time Graphs</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Detect intermittent dropouts, roaming packet loss, and signal fluctuations. The time graph tracks RSSI values across continuous scan iterations in real-time.
						</p>
					</div>

					<!-- Card 6 -->
					<div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all group">
						<div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">100% Offline & Private</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							No internet permission requested or required. Zero telemetry, no cloud accounts, and no data tracking. All measurements, floor plans, and RF calculations remain strictly on your device.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Frequently Asked Questions -->
		<section class="py-24 border-t border-slate-800/80 bg-[#050814]">
			<div class="container mx-auto px-6 max-w-4xl">
				<div class="text-center mb-16">
					<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
						Frequently Asked Questions
					</h2>
					<p class="text-slate-400">
						Answers to common questions regarding Android permissions, scanning governors, and features.
					</p>
				</div>

				<div class="space-y-6">
					<div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800">
						<h3 class="text-lg font-bold text-white mb-2">Why does the app require Location permission?</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Starting with Android 6.0 (Marshmallow) and enforced in modern versions, Google considers Wi-Fi beacon frame scanning capable of identifying physical location. Android strictly requires the <code class="text-cyan-300 font-mono">ACCESS_FINE_LOCATION</code> permission to return Wi-Fi scan results. WifiHeatmap functions 100% locally and does not transmit your location anywhere.
						</p>
					</div>

					<div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800">
						<h3 class="text-lg font-bold text-white mb-2">Why does it ask for Physical Activity permission?</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							The <code class="text-cyan-300 font-mono">ACTIVITY_RECOGNITION</code> permission powers the step detector sensor during floorplan heatmap surveys. This allows Pedestrian Dead Reckoning (PDR) to track your footsteps across the map in real-time as you walk.
						</p>
					</div>

					<div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800">
						<h3 class="text-lg font-bold text-white mb-2">How can I bypass Android Wi-Fi scan throttling?</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Android 9+ limits foreground Wi-Fi scans to 4 times per 2 minutes. On Android 10 and newer, you can disable this limitation in device settings: go to <em>Settings &gt; Developer Options &gt; Networking &gt; Wi-Fi scan throttling</em> and toggle it off. This allows scans every 2 to 4 seconds for ultra-dense surveys.
						</p>
					</div>

					<div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800">
						<h3 class="text-lg font-bold text-white mb-2">Can WifiHeatmap crack passwords or hack networks?</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							No. WifiHeatmap is strictly a legal, professional diagnostic and surveying utility. It does not perform unauthorized penetration testing, packet injection, or credential cracking.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Bottom Call-To-Action Banner -->
		<section class="py-20 border-t border-slate-800 bg-gradient-to-b from-[#070c1c] to-[#050814] relative overflow-hidden">
			<div class="container mx-auto px-6 max-w-5xl text-center relative z-10">
				<h2 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-6">
					Optimize Your Wireless Network Today
				</h2>
				<p class="text-slate-300 text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
					Survey, analyze, and optimize your indoor wireless environment with professional precision and zero cloud telemetry.
				</p>
				<div class="flex justify-center items-center">
					<a
						href="https://play.google.com/store/apps/details?id=com.heymeowcat.wifiheatmap"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block transition-transform hover:scale-[1.03]"
					>
						<img
							src={`${import.meta.env.BASE_URL}/google-play-badge-logo-svgrepo-com.svg`}
							alt="Get it on Google Play"
							class="h-16 w-auto drop-shadow-xl"
						/>
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
