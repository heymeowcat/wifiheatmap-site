---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import FeatureShowcase from "../components/FeatureShowcase.astro";
import SectionHeading from "../components/SectionHeading.astro";
import AppScreenshots from "../components/AppScreenshots.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import HeatHaze from "../components/HeatHaze.astro";
import { SITE, PLAY_STORE_URL } from "../config";
import {
	graph,
	organizationSchema,
	websiteSchema,
	appSchema,
	breadcrumbSchema,
} from "../lib/schema";

const base = SITE.base;

const title = "WifiHeatmap — Android Wi-Fi Analyzer & Indoor Site Survey";
const description =
	"Free offline Android Wi-Fi analyzer and site survey app. Paint floorplan signal heatmaps, chart 2.4/5/6 GHz spectrums and get star-rated channel picks.";

const structuredData = graph(
	organizationSchema(),
	websiteSchema(),
	appSchema(),
	breadcrumbSchema([{ label: "Home", href: "/" }]),
);

const faqs = [
	{
		question: "Does WifiHeatmap need an internet connection?",
		answer:
			"No. Every feature — scanning, channel graphs, heatmap surveys, channel rating and report exports — runs entirely on your device. The app requests no internet permission for its core functionality and contains no telemetry, analytics or background tracking. The optional Network Tools (ping, traceroute, DNS, speed test) is the only part that touches the network, and only against hosts you explicitly choose.",
	},
	{
		question: "Why does Android require the Location permission to scan Wi-Fi?",
		answer:
			"Since Android 6.0 the operating system classifies Wi-Fi beacon frame scanning as location-sensitive data, because nearby BSSIDs could theoretically be correlated to coordinates. Android therefore returns empty scan results unless <code>ACCESS_FINE_LOCATION</code> is granted. WifiHeatmap processes beacon frames in local memory only — your location is never logged, stored or transmitted.",
	},
	{
		question: "What is the Physical Activity permission used for?",
		answer:
			"<code>ACTIVITY_RECOGNITION</code> powers the hardware step detector during floorplan heatmap surveys. It lets Pedestrian Dead Reckoning (PDR) chart your footsteps on the map as you walk, using the adaptive Weinberg formula for step length combined with compass heading. Step data is only recorded during an active survey and is discarded when the session ends.",
	},
	{
		question: "How accurate are the floorplan heatmaps?",
		answer:
			"WifiHeatmap interpolates your sampled signal readings across the imported floor plan using Inverse Distance Weighting (IDW), which is the standard approach for radio propagation modelling between sparse measurement points. Accuracy depends on how densely you sample the space — the closer your walk steps are to the areas you care about, the more faithfully the contour reflects real coverage. Walls, furniture and multi-floor buildings all affect RF propagation.",
	},
	{
		question: "Can I bypass Android's Wi-Fi scan throttling?",
		answer:
			"Android 9+ limits foreground Wi-Fi scans to four per two minutes, which can make results look stale. On Android 10 and newer you can lift the limit under <em>Settings &gt; Developer Options &gt; Networking &gt; Wi-Fi scan throttling</em>. With throttling off, scans run every two to four seconds, which is ideal for dense surveys. The app also warns you in-app when it detects that scans are being throttled.",
	},
	{
		question: "Can WifiHeatmap crack passwords or hack networks?",
		answer:
			"No. WifiHeatmap is strictly a legal, professional diagnostic and surveying utility. It does not perform penetration testing, packet injection, deauthentication or credential cracking of any kind. It only observes beacon frames that your own device's Wi-Fi radio already receives.",
	},
	{
		question: "Which Wi-Fi generations and channels are supported?",
		answer:
			"2.4 GHz, 5 GHz and 6 GHz bands are supported, including Wi-Fi 6E and Wi-Fi 7. Channel width detection covers 20, 40, 80, 160 and 320 MHz. The app also identifies the IEEE standard behind each access point (802.11n/ac/ax/be), the security type (WPA3, WPA2, WPA, WEP, WPS, OWE, EAP) and fast-roaming flags (802.11k, 802.11v, 802.11r, OKC).",
	},
	{
		question: "How much does WifiHeatmap cost?",
		answer:
			"Nothing. WifiHeatmap is free on Google Play, requires no account and contains no advertisements or in-app purchases. The full source code is published under the GNU General Public License v3.0.",
	},
];

const capabilities = [
	{
		title: "PDR motion kinematics",
		body: "Walk through a facility naturally. The adaptive Weinberg model calculates individual step length while the compass supplies heading, so your track is drawn on the map automatically.",
		icon: "M13 5.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0ZM8 21l1.5-6 2.5 2 2-4 2 8",
		tone: "text-sky-700 bg-sky-50 border-sky-200",
	},
	{
		title: "Wi-Fi 6E & Wi-Fi 7 ready",
		body: "Diagnose the clean 6 GHz band alongside legacy 2.4 GHz and 5 GHz, with bandwidth detection from 20 MHz all the way up to 320 MHz on 802.11be networks.",
		icon: "M13 10V3L4 14h7v7l9-11h-7z",
		tone: "text-emerald-700 bg-emerald-50 border-emerald-200",
	},
	{
		title: "Channel rating optimiser",
		body: "Eliminate co-channel congestion for good. Automated star-rating analysis reveals exactly which channels suffer from overlapping interference in your area.",
		icon: "M12 3l2.6 5.6 6 .8-4.4 4.2 1.1 6-5.3-3-5.3 3 1.1-6L3.4 9.4l6-.8L12 3z",
		tone: "text-amber-700 bg-amber-50 border-amber-200",
	},
	{
		title: "Vendor / OUI lookup",
		body: "Identify access point manufacturers instantly from the MAC address OUI — Cisco, Aruba, Ubiquiti, Apple, Netgear, TP-Link and thousands more.",
		icon: "M4 6h16M4 12h16M4 18h10",
		tone: "text-cyan-700 bg-cyan-50 border-cyan-200",
	},
	{
		title: "Signal stability time graphs",
		body: "Catch intermittent dropouts, roaming packet loss and signal fluctuation. The time graph tracks RSSI across continuous scan iterations in real time.",
		icon: "M3 16l4-6 4 3 4-8 4 5",
		tone: "text-indigo-700 bg-indigo-50 border-indigo-200",
	},
	{
		title: "100% offline & private",
		body: "No telemetry, no cloud accounts, no data tracking. Every measurement, floor plan and RF calculation stays on your device.",
		icon: "M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z",
		tone: "text-rose-700 bg-rose-50 border-rose-200",
	},
];

const useCases = [
	{
		title: "Enterprise site surveys",
		body: "Validate an office, campus or warehouse floor plan before you sign off the AP layout — and keep the heat map as client-facing evidence.",
	},
	{
		title: "Dead-zone hunting",
		body: "Walk the building, watch the colour field, and find exactly where coverage drops below -67 dBm before staff start complaining.",
	},
	{
		title: "Home & mesh tuning",
		body: "Compare rooms, find the position where your router performs best and pick a channel that is not fighting your neighbours.",
	},
	{
		title: "Interference forensics",
		body: "Spot a crowded 2.4 GHz band, an unstable 5 GHz link or a legacy 802.11b device dragging down your throughput.",
	},
];

const steps = [
	{
		step: "01",
		title: "Import a floor plan",
		body: "Load any image of the space you are surveying — an office plan, a warehouse layout or a photo of the floor.",
	},
	{
		step: "02",
		title: "Walk the space",
		body: "Walk normally with your phone. Step detection and compass heading plot your track automatically.",
	},
	{
		step: "03",
		title: "Read the field",
		body: "Signal readings are interpolated into a live colour field so hot spots and dead zones are obvious at a glance.",
	},
	{
		step: "04",
		title: "Export & act",
		body: "Save the heat report image or raw survey CSV, then configure your access point on the recommended channel.",
	},
];
---

<Layout
	title={title}
	description={description}
	path="/"
	structuredData={structuredData}
>
	<SiteHeader />

	<main id="main" class="bg-ink-950">
		<Hero />

		<!-- ============ Interactive feature suite ============ -->
		<FeatureShowcase />

		<!-- ============ Screenshots ============ -->
		<section
			class="section-y relative overflow-hidden border-t border-white/70 bg-white/40"
			aria-labelledby="screenshots-heading"
		>
			<div
				class="pointer-events-none absolute left-1/2 top-10 h-72 w-[44rem] -translate-x-1/2 rounded-full opacity-50 blur-3xl"
				style="background:radial-gradient(circle,rgba(250,204,21,0.5),rgba(251,146,60,0.35),transparent 70%)"
				aria-hidden="true"
			>
			</div>

			<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<SectionHeading
					id="screenshots-heading"
					eyebrow="The real app"
					title="Every screen, exactly as it ships"
					description="No mockups. These are live captures from WifiHeatmap 1.0.2 on Android, running on the same light and dark themes you can switch between in the app."
				/>

				<div class="mt-14">
					<AppScreenshots tone="all" />
				</div>

				<div class="mt-14 flex justify-center">
					<a
						href={PLAY_STORE_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-xl bg-[linear-gradient(120deg,#22d3ee,#38bdf8_45%,#818cf8)] px-6 py-3 text-sm font-bold text-slate-900 shadow-[0_14px_30px_-14px_rgba(14,165,233,0.95)] transition-transform duration-200 hover:scale-[1.03]"
					>
						<span>Try it free on Google Play</span>
						<svg
							class="h-4 w-4"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M5 12h14m-6-7 7 7-7 7"
							></path>
						</svg>
					</a>
				</div>
			</div>
		</section>

		<!-- ============ How it works ============ -->
		<section
			class="section-y relative overflow-hidden border-t border-white/70 bg-white/70"
			aria-labelledby="how-heading"
		>
			<HeatHaze class="-z-10" intensity={0.8} />

			<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<SectionHeading
					id="how-heading"
					eyebrow="How it works"
					title="Four steps from floor plan to coverage map"
				/>

				<ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{
						steps.map((step, index) => (
							<li class="glass-rainbow relative overflow-hidden rounded-3xl p-6">
								<span
									class="font-mono text-sm font-black tracking-widest"
									style="background-image:linear-gradient(90deg,#0ea5e9,#22c55e,#eab308,#f97316,#ef4444);background-clip:text;-webkit-background-clip:text;color:transparent"
								>
									{step.step}
								</span>
								<h3 class="mt-3 text-lg font-bold text-slate-900">{step.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-slate-600">
									{step.body}
								</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- ============ Capabilities grid ============ -->
		<section
			class="section-y border-t border-white/70 bg-white/40"
			aria-labelledby="capabilities-heading"
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<SectionHeading
					id="capabilities-heading"
					eyebrow="Built for wireless professionals &amp; enthusiasts"
					title="Enterprise-grade RF analysis, in your pocket"
					description="From campus Wi-Fi surveys to home mesh tuning, WifiHeatmap gives you complete technical control of your wireless environment."
				/>

				<div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{
						capabilities.map((item) => (
							<article class="glass-rainbow group rounded-3xl p-7 transition-all hover:-translate-y-1 hover:shadow-[0_30px_60px_-28px_rgba(37,99,235,0.5)]">
								<span
									class:list={[
										"mb-5 flex h-12 w-12 items-center justify-center rounded-2xl border transition-transform duration-300 group-hover:scale-110",
										item.tone,
									]}
								>
									<svg
										class="h-6 w-6"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path d={item.icon} />
									</svg>
								</span>
								<h3 class="text-lg font-bold text-slate-900">{item.title}</h3>
								<p class="mt-2.5 text-sm leading-relaxed text-slate-600">
									{item.body}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============ Use cases ============ -->
		<section
			class="section-y border-t border-white/70 bg-white/70"
			aria-labelledby="usecases-heading"
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
					<div>
						<SectionHeading
							id="usecases-heading"
							align="left"
							eyebrow="Who it's for"
							title="One app, four very different jobs"
							description="If a problem is about radio coverage or channel choice, WifiHeatmap measures it directly instead of guessing."
						/>
						<div class="mt-8 flex flex-wrap gap-3">
							<a
								href={`${base}/features/floorplan-heatmap/`}
								class="inline-flex items-center gap-2 rounded-xl bg-[linear-gradient(120deg,#22d3ee,#38bdf8_45%,#818cf8)] px-5 py-3 text-sm font-bold text-slate-900 shadow-[0_14px_30px_-14px_rgba(14,165,233,0.95)] transition-transform duration-200 hover:scale-[1.03]"
							>
								<span>See floorplan surveys</span>
							</a>
							<a
								href={`${base}/features/network-tools/`}
								class="inline-flex items-center gap-2 rounded-xl border border-white/80 bg-white/70 px-5 py-3 text-sm font-semibold text-slate-700 shadow-[0_0_0_1px_rgba(148,163,184,0.22)] backdrop-blur-md transition-all hover:-translate-y-0.5 hover:text-slate-900"
							>
								<span>See network diagnostics</span>
							</a>
						</div>
					</div>

					<ul class="grid gap-4 sm:grid-cols-2">
						{
							useCases.map((useCase) => (
								<li class="glass rounded-2xl p-5">
									<h3 class="text-base font-bold text-slate-900">{useCase.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-slate-600">
										{useCase.body}
									</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- ============ FAQ ============ -->
		<section
			class="section-y border-t border-white/70 bg-white/40"
			aria-labelledby="faq-heading"
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<SectionHeading
					id="faq-heading"
					eyebrow="FAQ"
					title="Frequently asked questions"
					description="Everything about permissions, scan throttling, accuracy and privacy."
				/>

				<div class="mt-12">
					<FaqList items={faqs} withSchema={false} />
				</div>
			</div>
		</section>

		<CtaBand />
	</main>

	<SiteFooter />
</Layout>
