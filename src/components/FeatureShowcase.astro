---
import { withBase } from "../config";

interface Feature {
	id: string;
	badge: string;
	title: string;
	tagline: string;
	description: string;
	highlights: string[];
	/** Accent colour for the icon chip. */
	accent: string;
	icon: "map" | "wifi" | "chart" | "star" | "wrench";
	href: string;
	hrefLabel: string;
}

const features: Feature[] = [
	{
		id: "heatmap",
		badge: "PDR Indoor Survey",
		title: "Floorplan signal heatmaps",
		tagline: "Walk freely while your phone maps RF coverage step by step.",
		description:
			"Import any floor plan and walk naturally. WifiHeatmap fuses biomechanical step detection (adaptive Weinberg formula) with orientation sensors to chart your continuous path, then interpolates signal contours with Inverse Distance Weighting (IDW).",
		highlights: [
			"Weinberg step detection with heading-sensor fusion",
			"Inverse Distance Weighting (IDW) gradient contours",
			"Multi-floor surveys via barometric altitude detection",
			"Walk, A→B, tap-pin and GPS survey modes",
			"Export heat report images and raw survey CSV",
		],
		accent: "text-sky-700 bg-sky-100 border-sky-200",
		icon: "map",
		href: "/features/floorplan-heatmap/",
		hrefLabel: "Explore the heatmap feature",
	},
	{
		id: "networks",
		badge: "Access Point Inspector",
		title: "Every beacon in the air, decoded",
		tagline: "Full technical detail for each access point around you.",
		description:
			"Inspect channel, frequency, link speed, signal and estimated distance for every nearby access point. The built-in OUI vendor database identifies router manufacturers, while the roaming logger records BSSID handoffs as you walk.",
		highlights: [
			"Complete or compact access point views",
			"Estimated distance via Free-Space Path Loss (FSPL)",
			"Security detection: WPA3, WPA2, WEP, WPS, OWE, EAP",
			"Wi-Fi standard identification up to 802.11be",
			"Fast-roaming flags: 802.11k / 802.11v / 802.11r / OKC",
		],
		accent: "text-cyan-700 bg-cyan-100 border-cyan-200",
		icon: "wifi",
		href: "/features/spectrum-analyzer/",
		hrefLabel: "Explore network analysis",
	},
	{
		id: "spectrum",
		badge: "Spectrum Analyzer",
		title: "Tri-band channel graphs",
		tagline: "Visualise frequency overlap across 2.4, 5 and 6 GHz.",
		description:
			"Inspect complex RF environments in real time. View overlapping parabolic channel curves, detect bandwidths up to 320 MHz (Wi-Fi 7), and isolate interference from legacy 802.11b/g up to modern 802.11be networks.",
		highlights: [
			"2.4 GHz, 5 GHz and 6 GHz (Wi-Fi 6E / Wi-Fi 7) support",
			"Channel width detection: 20, 40, 80, 160 and 320 MHz",
			"Live scan counter with scan-throttle detection",
			"Pinch to zoom and pan across the 5 / 6 GHz axis",
			"Filter by band, signal strength, SSID or security type",
		],
		accent: "text-emerald-700 bg-emerald-100 border-emerald-200",
		icon: "chart",
		href: "/features/spectrum-analyzer/",
		hrefLabel: "Explore the spectrum analyzer",
	},
	{
		id: "rating",
		badge: "Intelligent Scoring",
		title: "Channel rating & optimisation",
		tagline: "Identify zero-interference channels in crowded spectrums.",
		description:
			"Stop guessing which channel to configure on your access points. WifiHeatmap evaluates co-channel and adjacent-channel congestion to award transparent 1-to-5 star ratings for every available channel, and recommends the cleanest ones.",
		highlights: [
			"Instant best-channel recommendations for 2.4 & 5 GHz",
			"Co-channel vs adjacent-channel interference breakdown",
			"Active access point count per channel",
			"Transparent 1–5 star scoring you can audit",
			"Recommended channels listed up front",
		],
		accent: "text-amber-700 bg-amber-100 border-amber-200",
		icon: "star",
		href: "/features/channel-rating/",
		hrefLabel: "Explore channel rating",
	},
	{
		id: "tools",
		badge: "Diagnostics & Performance",
		title: "A full network toolkit",
		tagline: "A complete diagnostics bench for any wireless network, in your pocket.",
		description:
			"Jump straight to your router's admin page, then run real download and upload speed tests, ICMP ping and jitter checks, hop-by-hop traceroutes, and A / AAAA / PTR DNS lookups — all pointed at hosts you choose yourself.",
		highlights: [
			"One-tap router admin access via the detected gateway IP",
			"Speed and throughput testing with live latency",
			"Ping, jitter, packet-loss and traceroute utilities",
			"A / AAAA / PTR DNS lookup and reverse DNS",
			"BSSID roaming logger for seamless AP handoffs",
		],
		accent: "text-indigo-700 bg-indigo-100 border-indigo-200",
		icon: "wrench",
		href: "/features/network-tools/",
		hrefLabel: "Explore the network toolkit",
	},
];

const icons: Record<Feature["icon"], string> = {
	map: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7",
	wifi:
		"M12 20 1 8a17 17 0 0 1 22 0L12 20Zm0-4.5L4.5 11a12 12 0 0 1 15 0L12 15.5Z",
	chart: "M3 3v18h18M7 15l4-5 3 3 5-7",
	star: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
	wrench:
		"M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm0 0V2m0 18v-2M4 11H2m18 0h-2",
};
---

<section
	id="showcase"
	class="section-y relative overflow-hidden border-t border-white/70 bg-white/40"
	aria-labelledby="showcase-heading"
>
	<!-- Rainbow wash -->
	<div
		class="pointer-events-none absolute -left-40 top-1/3 h-[34rem] w-[34rem] rounded-full opacity-45 blur-3xl"
		style="background:radial-gradient(circle,rgba(34,211,238,0.65),transparent 65%)"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -right-40 bottom-1/4 h-[30rem] w-[30rem] rounded-full opacity-45 blur-3xl"
		style="background:radial-gradient(circle,rgba(251,146,60,0.6),transparent 65%)"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Section header -->
		<div class="mx-auto mb-12 max-w-3xl text-center">
			<p class="chip mb-4 text-sky-700 shadow-[0_0_0_1px_rgba(14,165,233,0.3)]">
				<svg
					class="h-3.5 w-3.5"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z"
					></path>
				</svg>
				<span class="uppercase tracking-[0.14em]">Interactive feature suite</span>
			</p>
			<h2
				id="showcase-heading"
				class="text-balance text-3xl font-black tracking-tight text-slate-900 sm:text-4xl lg:text-5xl"
			>
				Engineered for precision RF analysis
			</h2>
			<p class="mt-4 text-pretty text-base leading-relaxed text-slate-600 sm:text-lg">
				Five tools in one offline app — tap through the real screens below to see
				exactly what network engineers use on site.
			</p>
		</div>

		<!-- Tabs -->
		<div
			role="tablist"
			aria-label="WifiHeatmap feature tabs"
			class="mb-14 flex flex-wrap justify-center gap-2 sm:gap-3"
		>
			{
				features.map((feature, index) => (
					<button
						type="button"
						role="tab"
						id={`tab-${feature.id}`}
						aria-controls={`panel-${feature.id}`}
						aria-selected={index === 0 ? "true" : "false"}
						tabindex={index === 0 ? 0 : -1}
						data-showcase-tab={feature.id}
						data-active={index === 0 ? "true" : "false"}
						class="showcase-tab flex items-center gap-2 rounded-full border px-4 py-2.5 text-sm font-bold transition-all duration-200"
					>
						<span
							class:list={[
								"showcase-tab-icon flex h-6 w-6 items-center justify-center rounded-full border",
								feature.accent,
							]}
						>
							<svg
								class="h-3.5 w-3.5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path d={icons[feature.icon]} />
							</svg>
						</span>
						<span class="whitespace-nowrap">{feature.badge}</span>
					</button>
				))
			}
		</div>

		<!-- Stage: one centred column, all panels stacked in the same grid cell
		     so switching tabs never shifts the layout. -->
		<div class="mx-auto max-w-3xl">
			<div class="grid">
				{
					features.map((feature, index) => (
						<div
							role="tabpanel"
							id={`panel-${feature.id}`}
							aria-labelledby={`tab-${feature.id}`}
							data-showcase-panel={feature.id}
							data-active={index === 0 ? "true" : "false"}
							class="col-start-1 row-start-1 text-center transition-opacity duration-300"
						>
							<div
								class:list={[
									"mb-4 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em]",
									feature.accent,
								]}
							>
								{feature.badge}
							</div>
							<h3 class="text-balance text-2xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">
								{feature.title}
							</h3>
							<p class="mx-auto mt-3 max-w-2xl text-pretty text-base font-semibold text-sky-700 sm:text-lg">
								{feature.tagline}
							</p>
							<p class="mx-auto mt-4 max-w-2xl text-pretty text-sm leading-relaxed text-slate-600 sm:text-base">
								{feature.description}
							</p>

							<ul class="mx-auto mt-7 grid max-w-2xl gap-3 sm:grid-cols-2">
								{feature.highlights.map((item) => (
									<li class="glass flex items-start gap-3 rounded-2xl px-4 py-3 text-left">
										<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-heat-2 to-heat-4">
											<svg
												class="h-3.5 w-3.5 text-slate-900"
												fill="none"
												stroke="currentColor"
												stroke-width="3"
												viewBox="0 0 24 24"
												aria-hidden="true"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													d="m5 13 4 4L19 7"
												/>
											</svg>
										</span>
										<span class="text-sm text-slate-700">{item}</span>
									</li>
								))}
							</ul>

							<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
								<a
									href={withBase(feature.href)}
									class="inline-flex items-center gap-2 rounded-xl bg-[linear-gradient(120deg,#22d3ee,#38bdf8_45%,#818cf8)] px-5 py-3 text-sm font-bold text-slate-900 shadow-[0_14px_30px_-14px_rgba(14,165,233,0.95)] transition-transform duration-200 hover:scale-[1.03]"
								>
									<span>{feature.hrefLabel}</span>
									<svg
										class="h-4 w-4"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M5 12h14m-6-7 7 7-7 7"
										/>
									</svg>
								</a>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Panels share one grid cell: switching tabs never reflows the page. */
	[data-showcase-panel] {
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px);
	}
	[data-showcase-panel][data-active="true"] {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	/* Tab states are driven by a data attribute so the JS never has to
	   juggle multi-token class names. */
	.showcase-tab[data-active="false"] {
		border-color: rgb(15 23 42 / 0.1);
		background: rgb(255 255 255 / 0.7);
		color: var(--color-slate-600);
		box-shadow: 0 0 0 1px rgb(148 163 184 / 0.18);
	}
	.showcase-tab[data-active="false"]:hover {
		transform: translateY(-2px);
		background: #fff;
		color: var(--color-slate-900);
	}

	.showcase-tab[data-active="true"] {
		border-color: transparent;
		background: linear-gradient(
			120deg,
			#22d3ee,
			#38bdf8 45%,
			#818cf8
		);
		color: var(--color-slate-900);
		box-shadow: 0 14px 30px -14px rgb(14 165 233 / 0.95);
	}

	.showcase-tab-icon[data-active="true"],
	.showcase-tab[data-active="true"] .showcase-tab-icon {
		border-color: rgb(15 23 42 / 0.15);
		background: rgb(255 255 255 / 0.45);
		color: var(--color-slate-900);
	}
</style>

<script>
	const root = document.getElementById("showcase");
	if (root) {
		const tabs = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-showcase-tab]"),
		);
		const panels = Array.from(
			root.querySelectorAll<HTMLElement>("[data-showcase-panel]"),
		);

		function activate(id: string, focus = false) {
			for (const tab of tabs) {
				const active = tab.dataset.showcaseTab === id;
				tab.setAttribute("aria-selected", String(active));
				tab.dataset.active = String(active);
				tab.tabIndex = active ? 0 : -1;
				if (active && focus) tab.focus();
			}
			for (const panel of panels) {
				const active = panel.dataset.showcasePanel === id;
				panel.dataset.active = String(active);
				panel.setAttribute("aria-hidden", String(!active));
			}
		}

		for (const tab of tabs) {
			tab.addEventListener("click", () => {
				const id = tab.dataset.showcaseTab;
				if (id) activate(id);
			});
		}

		// Roving tabindex + arrow-key navigation (WAI-ARIA tabs pattern).
		root
			.querySelector('[role="tablist"]')
			?.addEventListener("keydown", (event: KeyboardEvent) => {
				const index = tabs.findIndex((tab) => tab === document.activeElement);
				if (index === -1) return;
				let next = index;
				if (event.key === "ArrowRight" || event.key === "ArrowDown") {
					next = (index + 1) % tabs.length;
				} else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
					next = (index - 1 + tabs.length) % tabs.length;
				} else if (event.key === "Home") {
					next = 0;
				} else if (event.key === "End") {
					next = tabs.length - 1;
				} else {
					return;
				}
				event.preventDefault();
				const id = tabs[next].dataset.showcaseTab;
				if (id) activate(id, true);
			});
	}
</script>
