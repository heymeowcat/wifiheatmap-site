---
/**
 * Shared shell for the legal pages so both keep identical structure,
 * heading hierarchy and internal links.
 */
export interface LegalSection {
	heading: string;
	/** HTML content. */
	body: string;
}

interface Props {
	eyebrow: string;
	title: string;
	updated: string;
	accent?: "emerald" | "indigo";
	sections: LegalSection[];
	after?: string;
}

const { eyebrow, title, updated, accent = "emerald", sections } = Astro.props;

const accentClasses: Record<string, string> = {
	emerald: "text-emerald-700 border-emerald-200 bg-emerald-50",
	indigo: "text-indigo-700 border-indigo-200 bg-indigo-50",
};
---

<section class="relative isolate overflow-hidden pb-16 pt-28 sm:pt-32">
	<div
		class="pointer-events-none absolute -top-32 left-1/2 h-80 w-[42rem] -translate-x-1/2 rounded-full opacity-50 blur-3xl"
		style="background:radial-gradient(circle,rgba(34,211,238,0.55),transparent 68%)"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<p class:list={["chip mb-5 border", accentClasses[accent]]}>
			<span class="uppercase tracking-[0.14em]">{eyebrow}</span>
		</p>
		<h1
			class="text-balance text-[2rem] font-black leading-[1.1] tracking-tight text-slate-900 sm:text-5xl"
		>
			{title}
		</h1>
		<p class="mt-4 text-sm text-slate-600">Last updated: {updated}</p>

		<div class="mt-12 space-y-10 text-pretty leading-relaxed text-slate-700">
			{
				sections.map((section) => (
					<section class="glass rounded-3xl p-6 sm:p-8">
						<h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
							{section.heading}
						</h2>
						<div class="mt-4 space-y-4 text-sm text-slate-600 sm:text-base">
							<Fragment set:html={section.body} />
						</div>
					</section>
				))
			}
		</div>

		<div class="rule-rainbow my-12"></div>

		<p class="text-sm text-slate-600">
			Questions about this policy? Reach the developer through the
			<a
				href="https://play.google.com/store/apps/details?id=com.heymeowcat.wifiheatmap"
				target="_blank"
				rel="noopener noreferrer"
				class="font-semibold text-sky-700 underline underline-offset-4 hover:text-sky-800"
				>WifiHeatmap Google Play listing</a
			>.
		</p>
	</div>
</section>
