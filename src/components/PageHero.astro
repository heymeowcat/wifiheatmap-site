---
import HeatHaze from "./HeatHaze.astro";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	crumbs: { label: string; href?: string }[];
	/** Optional accent colour for the eyebrow chip. */
	accent?: "cyan" | "emerald" | "amber" | "indigo" | "rose" | "sky";
}

const {
	eyebrow,
	title,
	description,
	crumbs,
	accent = "sky",
} = Astro.props;

const accentClasses: Record<string, string> = {
	cyan: "text-cyan-700 border-cyan-200 bg-cyan-50",
	emerald: "text-emerald-700 border-emerald-200 bg-emerald-50",
	amber: "text-amber-700 border-amber-200 bg-amber-50",
	indigo: "text-indigo-700 border-indigo-200 bg-indigo-50",
	rose: "text-rose-700 border-rose-200 bg-rose-50",
	sky: "text-sky-700 border-sky-200 bg-sky-50",
};
---

<section class="relative isolate overflow-hidden pb-14 pt-28 sm:pb-16 sm:pt-32">
	<HeatHaze class="-z-10" intensity={0.75} grid />

	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<Breadcrumbs items={crumbs} class="mb-8" />

		<div class="max-w-3xl">
			<p class:list={["chip mb-5 border", accentClasses[accent]]}>
				<span class="uppercase tracking-[0.14em]">{eyebrow}</span>
			</p>
			<h1
				class="text-balance text-[2rem] font-black leading-[1.1] tracking-tight text-slate-900 sm:text-5xl"
			>
				{title}
			</h1>
			<p class="mt-6 text-pretty text-base leading-relaxed text-slate-600 sm:text-lg">
				{description}
			</p>
		</div>
	</div>
</section>
