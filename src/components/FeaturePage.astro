---
import PageHero from "./PageHero.astro";
import SectionHeading from "./SectionHeading.astro";
import FaqList from "./FaqList.astro";
import CtaBand from "./CtaBand.astro";
import HeatHaze from "./HeatHaze.astro";
import { withBase } from "../config";

export interface FeatureCapability {
	title: string;
	body: string;
}

export interface FeatureStep {
	title: string;
	body: string;
}

export interface FeatureSpec {
	label: string;
	value: string;
}

export interface FeatureFaq {
	question: string;
	answer: string;
}

export interface RelatedFeature {
	label: string;
	href: string;
	blurb: string;
}

interface Props {
	slug: string;
	eyebrow: string;
	title: string;
	description: string;
	accent: "cyan" | "emerald" | "amber" | "indigo" | "rose" | "sky";
	intro: string;
	capabilities: FeatureCapability[];
	steps: FeatureStep[];
	specs: FeatureSpec[];
	faqs: FeatureFaq[];
	related: RelatedFeature[];
}

const {
	slug,
	eyebrow,
	title,
	description,
	accent,
	intro,
	capabilities,
	steps,
	specs,
	faqs,
	related,
} = Astro.props;
---

<PageHero
	eyebrow={eyebrow}
	title={title}
	description={description}
	crumbs={[{ label: "Features", href: "/features/floorplan-heatmap/" }, { label: eyebrow }]}
	accent={accent}
/>

<!-- ============ Overview ============ -->
<section class="relative overflow-hidden pb-20" aria-labelledby="overview-heading">
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
		<h2
			id="overview-heading"
			class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl"
		>
			What it does
		</h2>
		<div class="mt-5 space-y-4 text-pretty leading-relaxed text-slate-600">
			<Fragment set:html={intro} />
		</div>

		<ul class="mt-9 grid gap-4 sm:grid-cols-2">
			{
				capabilities.map((capability) => (
					<li class="glass-rainbow rounded-2xl p-5">
						<h3 class="text-base font-bold text-slate-900">{capability.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">
							{capability.body}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<!-- ============ How it works ============ -->
<section
	class="section-y relative overflow-hidden border-t border-white/70 bg-white/40"
	aria-labelledby="steps-heading"
>
	<HeatHaze class="-z-10" intensity={0.75} />

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<SectionHeading id="steps-heading" eyebrow="Workflow" title="How it works" />

		<ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step, index) => (
					<li class="glass relative overflow-hidden rounded-3xl p-6">
						<span
							class="font-mono text-sm font-black tracking-widest"
							style="background-image:linear-gradient(90deg,#0ea5e9,#22c55e,#eab308,#f97316,#ef4444);background-clip:text;-webkit-background-clip:text;color:transparent"
						>
							{String(index + 1).padStart(2, "0")}
						</span>
						<h3 class="mt-3 text-lg font-bold text-slate-900">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">
							{step.body}
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<!-- ============ Technical details ============ -->
<section
	class="section-y border-t border-white/70 bg-white/70"
	aria-labelledby="specs-heading"
>
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
		<SectionHeading
			id="specs-heading"
			eyebrow="Under the hood"
			title="Technical details"
			description="What the app actually measures, and the standards it speaks."
		/>

		<dl class="glass mt-12 overflow-hidden rounded-3xl">
			{
				specs.map((spec) => (
					<div class="flex flex-col gap-1 border-b border-slate-900/6 px-6 py-4 last:border-0 sm:flex-row sm:items-baseline sm:gap-6">
						<dt class="w-full shrink-0 text-sm font-semibold text-slate-900 sm:w-56">
							{spec.label}
						</dt>
						<dd class="text-sm leading-relaxed text-slate-600">{spec.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<!-- ============ FAQ ============ -->
<section
	class="section-y border-t border-white/70 bg-white/40"
	aria-labelledby="feature-faq-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<SectionHeading id="feature-faq-heading" eyebrow="FAQ" title="Common questions" />
		<div class="mt-12">
			<FaqList items={faqs} />
		</div>
	</div>
</section>

<!-- ============ Related ============ -->
<section
	class="section-y border-t border-white/70 bg-white/70"
	aria-labelledby="related-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<SectionHeading
			id="related-heading"
			eyebrow="Keep exploring"
			title="Related features"
		/>

		<ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				related.map((item) => (
					<li>
						<a
							href={withBase(item.href)}
							class="glass group flex h-full flex-col rounded-3xl p-6 transition-all hover:-translate-y-1 hover:shadow-[0_30px_60px_-28px_rgba(37,99,235,0.5)]"
						>
							<h3 class="text-base font-bold text-slate-900 transition-colors group-hover:text-sky-700">
								{item.label}
							</h3>
							<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
								{item.blurb}
							</p>
							<span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
								Read more
								<svg
									class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M5 12h14m-6-7 7 7-7 7"
									/>
								</svg>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<CtaBand />
