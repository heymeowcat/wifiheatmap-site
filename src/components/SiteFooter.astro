---
import { SITE, PLAY_STORE_URL, GITHUB_REPO_URL, APP_REPO_PUBLIC } from "../config";

const base = SITE.base;
const year = new Date().getFullYear();

const featureLinks = [
	{ label: "Floorplan Heatmap", href: "/features/floorplan-heatmap/" },
	{ label: "Spectrum Analyzer", href: "/features/spectrum-analyzer/" },
	{ label: "Channel Rating", href: "/features/channel-rating/" },
	{ label: "Network Tools", href: "/features/network-tools/" },
];

const siteLinks = [
	{ label: "Guides", href: "/guides/wifi-channel-guide/" },
	{ label: "Resources", href: "/resources/" },
	{ label: "About the app", href: "/about/" },
	{ label: "Changelog", href: "/changelog/" },
	{ label: "Privacy Policy", href: "/privacy/" },
	{ label: "Terms of Service", href: "/terms/" },
];

const rainbowDot = [
	"bg-heat-1",
	"bg-heat-2",
	"bg-heat-3",
	"bg-heat-4",
	"bg-heat-5",
	"bg-heat-6",
];
---

<footer class="relative overflow-hidden border-t border-white/70 bg-white/60 backdrop-blur-xl">
	<div
		class="pointer-events-none absolute inset-x-0 -top-24 h-64 opacity-70"
		style="background:linear-gradient(90deg,rgba(34,211,238,0.28),rgba(74,222,128,0.24) 25%,rgba(253,224,71,0.24) 50%,rgba(251,146,60,0.24) 75%,rgba(239,68,68,0.26));filter:blur(46px)"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 pb-10 pt-16 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-12">
			<!-- Brand block -->
			<div class="lg:col-span-5">
				<a href={`${base}/`} class="flex items-center gap-3">
					<img
						src={`${base}/icon.png`}
						alt=""
						aria-hidden="true"
						width="42"
						height="42"
						loading="lazy"
						decoding="async"
						class="h-10 w-10 rounded-xl object-contain shadow-[0_8px_20px_-8px_rgba(37,99,235,0.6)]"
					/>
					<span class="text-xl font-black tracking-tight text-slate-900"
						>WifiHeatmap</span
					>
				</a>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-slate-600">
					A privacy-first Android Wi-Fi analyser and indoor site survey app.
					Paint RF coverage heatmaps on any floor plan, chart 2.4/5/6 GHz
					spectrums and pick the least congested channel — all offline, with
					zero cloud telemetry.
				</p>

				<div class="mt-6 flex flex-wrap gap-2">
					<span
						class="chip text-emerald-700 shadow-[0_0_0_1px_rgba(16,185,129,0.25)]"
					>
						<svg
							class="h-3.5 w-3.5"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z"
							></path>
						</svg>
						100% offline
					</span>
					<span class="chip text-sky-700 shadow-[0_0_0_1px_rgba(14,165,233,0.25)]">
						<svg
							class="h-3.5 w-3.5"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M4 4h16v16H4z"
							></path>
							<path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8"
							></path>
						</svg>
						No telemetry
					</span>
					<span
						class="chip text-indigo-700 shadow-[0_0_0_1px_rgba(99,102,241,0.25)]"
					>
						<svg
							class="h-3.5 w-3.5"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M12 3v18M3 12h18"
							></path>
						</svg>
						GPL-3.0
					</span>
				</div>
			</div>

			<!-- Link columns -->
			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
				<div>
					<h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
						Features
					</h2>
					<ul class="mt-5 space-y-1 text-sm">
						{
							featureLinks.map((link, index) => (
								<li>
									<a
										href={`${base}${link.href}`}
										class="inline-flex items-center gap-2 py-1.5 text-slate-600 transition-colors hover:text-slate-900"
									>
										<span
											class:list={[
												"h-1.5 w-1.5 rounded-full",
												rainbowDot[index % rainbowDot.length],
											]}
											aria-hidden="true"
										/>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
						Site
					</h2>
					<ul class="mt-5 space-y-1 text-sm">
						{
							siteLinks.map((link) => (
								<li>
									<a
										href={`${base}${link.href}`}
										class="inline-block py-1.5 text-slate-600 transition-colors hover:text-slate-900"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="col-span-2 sm:col-span-1">
					<h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
						Get the app
					</h2>
					<ul class="mt-5 space-y-1 text-sm">
						<li>
							<a
								href={PLAY_STORE_URL}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1.5 py-1.5 text-slate-600 transition-colors hover:text-slate-900"
							>
								Google Play
								<svg
									class="h-3 w-3"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M14 5l7 7m0 0l-7 7m7-7H3"
									></path>
								</svg>
							</a>
						</li>
						{
							APP_REPO_PUBLIC && (
								<li>
									<a
										href={GITHUB_REPO_URL}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 py-1.5 text-slate-600 transition-colors hover:text-slate-900"
									>
										Source code (GPL-3.0)
										<svg
											class="h-3 w-3"
											fill="none"
											stroke="currentColor"
											stroke-width="2.5"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M14 5l7 7m0 0l-7 7m7-7H3"
											/>
										</svg>
									</a>
								</li>
							)
						}
						<li>
							<a
								href={`${base}/sitemap.xml`}
								class="inline-block py-1.5 text-slate-600 transition-colors hover:text-slate-900"
								>sitemap.xml</a
							>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="rule-rainbow my-10"></div>

		<div
			class="flex flex-col items-center justify-between gap-4 text-xs text-slate-500 sm:flex-row"
		>
			<p>&copy; {year} {SITE.author}. WifiHeatmap is open source under GPL-3.0.</p>
			<p class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
				<a href={`${base}/privacy/`} class="inline-block py-1.5 hover:text-slate-900"
					>Privacy</a
				>
				<a href={`${base}/terms/`} class="inline-block py-1.5 hover:text-slate-900"
					>Terms</a
				>
				<a
					href={PLAY_STORE_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block py-1.5 hover:text-slate-900">Google Play</a
				>
			</p>
		</div>
	</div>
</footer>
