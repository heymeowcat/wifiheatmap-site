---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#04060f] border-t border-slate-800/80 pt-20 pb-12 text-slate-400 text-sm">
    <div class="container mx-auto px-6 max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
            <div class="col-span-1 md:col-span-2 space-y-4">
                <div class="flex items-center gap-3">
                    <img
                        src={`${import.meta.env.BASE_URL}/icon.png`}
                        alt="WifiHeatmap Icon"
                        class="w-9 h-9 rounded-xl object-contain shadow-sm"
                    />
                    <span class="text-2xl font-black text-white tracking-tight">WifiHeatmap</span>
                </div>
                <p class="text-slate-400 text-sm leading-relaxed max-w-md">
                    Professional Android Wi-Fi analyzer and indoor site survey application. Map coverage, visualize 2.4/5/6 GHz channels, and rate wireless frequencies with 100% offline privacy.
                </p>
                <div class="pt-2 flex items-center gap-3 text-xs text-slate-500 font-mono">
                    <span>100% Offline</span>
                    <span>•</span>
                    <span>Zero Cloud Telemetry</span>
                </div>
            </div>

            <div>
                <h4 class="text-white font-bold mb-5 tracking-wide text-xs uppercase text-slate-300">Navigation</h4>
                <ul class="space-y-3">
                    <li>
                        <a
                            href={`${import.meta.env.BASE_URL}/#features`}
                            class="hover:text-cyan-300 transition-colors"
                            >Features</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${import.meta.env.BASE_URL}/#showcase`}
                            class="hover:text-cyan-300 transition-colors"
                            >Interactive Showcase</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://play.google.com/store/apps/details?id=com.heymeowcat.wifiheatmap"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-cyan-300 transition-colors"
                            >Google Play Store</a
                        >
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-white font-bold mb-5 tracking-wide text-xs uppercase text-slate-300">Legal & Policy</h4>
                <ul class="space-y-3">
                    <li>
                        <a
                            href={`${import.meta.env.BASE_URL}/privacy-policy`}
                            class="hover:text-cyan-300 transition-colors"
                            >Privacy Policy</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${import.meta.env.BASE_URL}/terms-of-service`}
                            class="hover:text-cyan-300 transition-colors"
                            >Terms of Service</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500"
        >
            <p>
                &copy; {currentYear} WifiHeatmap. All rights reserved.
            </p>
            <div class="flex items-center gap-6">
                <a href={`${import.meta.env.BASE_URL}/privacy-policy`} class="hover:text-slate-300">
                    Privacy Policy
                </a>
                <a href={`${import.meta.env.BASE_URL}/terms-of-service`} class="hover:text-slate-300">
                    Terms of Service
                </a>
            </div>
        </div>
    </div>
</footer>
