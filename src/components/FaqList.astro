---
/**
 * Accessible FAQ list. Uses native <details>/<summary> so it works with
 * zero JavaScript and is fully indexable — plus a matching FAQPage
 * JSON-LD graph emitted alongside it.
 */
export interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	items: FaqItem[];
	/** Emits FAQPage structured data for the list. */
	withSchema?: boolean;
	headingId?: string;
}

const { items, withSchema = true, headingId } = Astro.props;

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: items.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer
				.replace(/<[^>]+>/g, "")
				.replace(/\s+/g, " ")
				.trim(),
		},
	})),
};
---

<div class="mx-auto max-w-3xl">
	<div class="space-y-3">
		{
			items.map((item, index) => (
				<details
					class="group glass rounded-2xl px-5 py-4 transition-shadow open:shadow-[0_24px_60px_-28px_rgba(37,99,235,0.45)] sm:px-6 sm:py-5"
					open={index === 0}
				>
					<summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left">
						<h3 class="text-pretty text-base font-bold text-slate-900 sm:text-lg">
							{item.question}
						</h3>
						<span
							class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[linear-gradient(120deg,#22d3ee,#818cf8)] text-slate-900 transition-transform duration-200 group-open:rotate-45"
							aria-hidden="true"
						>
							<svg
								class="h-3.5 w-3.5"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M12 5v14M5 12h14"
								/>
							</svg>
						</span>
					</summary>
					<div class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
						<Fragment set:html={item.answer} />
					</div>
				</details>
			))
		}
	</div>
</div>

{
	withSchema && (
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(faqSchema)}
		/>
	)
}
