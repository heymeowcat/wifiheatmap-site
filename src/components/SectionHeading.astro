---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	align?: "center" | "left";
	id?: string;
}

const {
	eyebrow,
	title,
	description,
	align = "center",
	id,
} = Astro.props;

const eyebrowTones: Record<string, string> = {
	cyan: "text-cyan-700 border-cyan-200 bg-cyan-50",
	emerald: "text-emerald-700 border-emerald-200 bg-emerald-50",
	amber: "text-amber-700 border-amber-200 bg-amber-50",
	indigo: "text-indigo-700 border-indigo-200 bg-indigo-50",
	rose: "text-rose-700 border-rose-200 bg-rose-50",
	sky: "text-sky-700 border-sky-200 bg-sky-50",
};
---

<div
	class:list={[
		"max-w-3xl",
		align === "center" ? "mx-auto text-center" : "text-left",
	]}
>
	{
		eyebrow && (
			<p
				class:list={[
					"chip mb-4 border",
					eyebrowTones[eyebrow.toLowerCase()] ?? eyebrowTones.sky,
				]}
			>
				<span class="uppercase tracking-[0.14em]">{eyebrow}</span>
			</p>
		)
	}
	<h2
		id={id}
		class="text-balance text-3xl font-black tracking-tight text-slate-900 sm:text-4xl lg:text-[2.75rem]"
	>
		{title}
	</h2>
	{
		description && (
			<p class="mt-4 text-pretty text-base leading-relaxed text-slate-600 sm:text-lg">
				{description}
			</p>
		)
	}
</div>
